# Upstream FastAPI backend (never exposed to the browser — all traffic is server-side)
API_BASE_URL=http://127.0.0.1:8000

# Better Auth (session cookie signing). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Server-only key used to encrypt the FastAPI JWT pair into httpOnly cookies.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Public origin of this Next.js app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Display-only origin of the FastAPI backend, used to show copyable webhook URLs.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
